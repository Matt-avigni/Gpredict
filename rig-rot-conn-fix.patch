+{
+    gchar cmd[64];
+    gchar reply[128];
+
+    if (token == NULL || *token == '\0')
+        return FALSE;
+
+    g_snprintf(cmd, sizeof(cmd), "V %s\x0a", token);
+    return rig_session_try_set_ok(ctrl, sock, cmd, reply, sizeof(reply));
+}
