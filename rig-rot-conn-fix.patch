+    el = CLAMP(pre.el_raw, transform->el_min_deg, transform->el_max_deg);
+
+    az = norm360(az);
+
+    if (out_az)
+        *out_az = az;
+    if (out_el)
+        *out_el = el;
+}
+
+static void apply_inverse_transform(const RotTransform *transform,
+                                    gdouble in_az, gdouble in_el,
+                                    gdouble *out_az, gdouble *out_el)
+{
+    gdouble az = in_az;
+    gdouble el = in_el;
