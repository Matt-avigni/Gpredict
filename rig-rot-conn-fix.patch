+
+    if (reply && reply_len > 0)
+        reply[0] = '\0';
+
+    ok = rig_session_send_command(ctrl, sock, cmd, reply, (gint) reply_len);
+    if (!ok)
+        return FALSE;
+
+    return check_set_response(reply, ok, __func__);
+}
